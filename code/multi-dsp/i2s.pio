.program i2s_tx
.side_set 2
; Side set: Bit 1 = WS (Pin 11), Bit 0 = SCK (Pin 10)
; 1 instruction = 1/2 BCLK cycle

    set x, 30          side 0b01 ; SCK=1, WS=0 (Left channel setup)
left_tx:
    out pins, 1        side 0b00 ; SCK=0, WS=0 (Shift data on falling edge)
    jmp x-- left_tx    side 0b01 ; SCK=1, WS=0 (Hold on rising edge)
    out pins, 1        side 0b10 ; SCK=0, WS=1 (WS changes 1 clock before Right MSB)

    set x, 30          side 0b11 ; SCK=1, WS=1
right_tx:
    out pins, 1        side 0b10 ; SCK=0, WS=1
    jmp x-- right_tx   side 0b11 ; SCK=1, WS=1
    out pins, 1        side 0b00 ; SCK=0, WS=0 (WS changes 1 clock before Left MSB)


.program i2s_rx
.side_set 2
; RX uses the exact same clock sequence, but reads data on the rising edge

    set x, 30          side 0b00
left_rx:
    in pins, 1         side 0b01 ; Read on rising edge
    jmp x-- left_rx    side 0b00
    in pins, 1         side 0b11

    set x, 30          side 0b10
right_rx:
    in pins, 1         side 0b11
    jmp x-- right_rx   side 0b10
    in pins, 1         side 0b01

% c-sdk {
static inline void i2s_tx_program_init(PIO pio, uint sm, uint offset, uint data_pin, uint clock_base) {
    pio_sm_config c = i2s_tx_program_get_default_config(offset);

    sm_config_set_out_pins(&c, data_pin, 1);
    sm_config_set_sideset_pins(&c, clock_base);

    pio_gpio_init(pio, data_pin);
    pio_gpio_init(pio, clock_base);
    pio_gpio_init(pio, clock_base + 1); // WS pin

    pio_sm_set_consecutive_pindirs(pio, sm, data_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, clock_base, 2, true); // TX drives clocks

    sm_config_set_out_shift(&c, false, true, 32); // Shift left, Autopull, 32-bits
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    sm_config_set_clkdiv(&c, 24.0f); // 144MHz / (46875 * 64 * 2) = 24.0
    pio_sm_init(pio, sm, offset, &c);
}

static inline void i2s_rx_program_init(PIO pio, uint sm, uint offset, uint data_pin, uint clock_base) {
    pio_sm_config c = i2s_rx_program_get_default_config(offset);

    sm_config_set_in_pins(&c, data_pin);
    pio_gpio_init(pio, data_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, data_pin, 1, false);

    // RX does NOT drive the clock pins (TX does), but side-set keeps it in perfect phase
    sm_config_set_in_shift(&c, false, true, 32); // Shift left, Autopush, 32-bits
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    sm_config_set_clkdiv(&c, 24.0f);
    pio_sm_init(pio, sm, offset, &c);
}
%}
